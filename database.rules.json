// REGLAS DE SEGURIDAD DE LA REALTIME DATABASE — IRONLOOP
//
// Modelo de amenaza: el cliente es hostil. Cualquiera puede abrir la consola y
// escribir aquí directamente. Estas reglas NO reimplementan la economía —es
// imposible en un lenguaje de reglas— sino que ACOTAN el daño:
//
//   1. Nadie escribe en el documento de otro jugador.
//   2. El dinero y la XP sólo crecen dentro de un límite por escritura. Un
//      exploit puede acelerar, no puede teletransportar a un billón.
//   3. El nivel no baja ni salta arbitrariamente.
//   4. Sólo los miembros de una fábrica pueden tocar esa fábrica.
//   5. Los campos de identidad (uid, createdAt) son inmutables.
//
// Mismo criterio que firestore.rules, del que son la traducción.
{
  "rules": {
    ".read": false,
    ".write": false,

    "users": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": "auth != null && auth.uid === $uid",

        "uid": { ".validate": "newData.val() === $uid" },

        "name": {
          ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 20"
        },

        "createdAt": {
          ".validate": "newData.isNumber() && (!data.exists() || newData.val() === data.val())"
        },

        // El dinero sólo puede bajar por un reinicio de fábrica, que es el
        // propio jugador poniendo su progreso a cero.
        "money": {
          ".validate": "newData.isNumber() && newData.val() >= 0 && (!data.exists() || newData.val() <= data.val() + 5000000)"
        },

        "xp": {
          ".validate": "newData.isNumber() && newData.val() >= 0 && (!data.exists() || newData.val() <= data.val() + 200000)"
        },

        "level": {
          ".validate": "newData.isNumber() && newData.val() >= 1 && (!data.exists() || newData.val() <= data.val() + 50)"
        },

        "stamina": {
          ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 2000"
        },

        "factoryId": { ".validate": "newData.isString() && newData.val().length <= 64" },

        "rev": { ".validate": "newData.isNumber() && newData.val() >= 0" },

        "$otro": { ".validate": true }
      }
    },

    // Nodo minúsculo por fábrica para el emparejamiento: se consulta ordenando
    // por aforo sin bajarse el estado entero de nadie.
    "factoryIndex": {
      ".read": "auth != null",
      ".indexOn": ["playerCount"],

      "$fid": {
        ".write": "auth != null",

        "playerCount": {
          ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 100"
        },
        "name": { ".validate": "newData.isString() && newData.val().length <= 40" },
        "level": { ".validate": "newData.isNumber() && newData.val() >= 1" },

        "$otro": { ".validate": false }
      }
    },

    "factories": {
      "$fid": {
        ".read": "auth != null",

        "state": {
          // Escriben los miembros de la fábrica. Crearla sí puede hacerlo
          // cualquiera autenticado: es como se entra cuando todas están llenas.
          ".write": "auth != null && (!data.exists() || root.child('factories').child($fid).child('members').child(auth.uid).exists())",

          "id": { ".validate": "newData.val() === $fid" },

          "createdAt": {
            ".validate": "newData.isNumber() && (!data.exists() || newData.val() === data.val())"
          },

          // COMPARA Y CAMBIA. Cada escritura de la fábrica manda rev+1; si dos
          // tripulantes coinciden, el segundo llega con un número que ya no es
          // el siguiente y se le rechaza. El cliente lo detecta, se refresca y
          // reintenta. Esto no es seguridad: es lo que evita que dos jugadores
          // se pisen el estado compartido.
          "rev": {
            ".validate": "newData.isNumber() && (!data.exists() || newData.val() === data.val() + 1)"
          },

          // El nivel sube, nunca baja ni salta de golpe. La excepción es el
          // administrador, que es quien puede reiniciar la fábrica: mismo
          // criterio y mismo correo que en firestore.rules.
          "level": {
            ".validate": "newData.isNumber() && newData.val() >= 1 && (!data.exists() || (newData.val() >= data.val() && newData.val() <= data.val() + 5) || (auth.token.email_verified === true && auth.token.email === 'kbros.contacto@gmail.com'))"
          },

          "contribution": { ".validate": "newData.isNumber() && newData.val() >= 0" },

          "totalContribution": {
            ".validate": "newData.isNumber() && (!data.exists() || newData.val() >= data.val() || (auth.token.email_verified === true && auth.token.email === 'kbros.contacto@gmail.com'))"
          },

          // Excepción a la regla de miembros: para ENTRAR hay que poder
          // reservar plaza, y todavía no eres miembro. Se acota a +1 por
          // escritura para que nadie invente aforo.
          "playerCount": {
            ".write": "auth != null",
            ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 100 && (!data.exists() || newData.val() <= data.val() + 1 || root.child('factories').child($fid).child('members').child(auth.uid).exists())"
          },

          "prestige": { ".validate": "newData.isNumber() && newData.val() >= 0" },

          "$otro": { ".validate": true }
        },

        // Documento público por jugador: es lo que alimenta el ranking. Cada
        // uno escribe sólo el suyo.
        "members": {
          "$uid": {
            ".write": "auth != null && auth.uid === $uid",

            "uid": { ".validate": "newData.val() === $uid" },
            "name": { ".validate": "newData.isString() && newData.val().length <= 20" },
            "level": { ".validate": "newData.isNumber() && newData.val() >= 1" },
            "money": { ".validate": "newData.isNumber() && newData.val() >= 0" },
            "contributed": { ".validate": "newData.isNumber() && newData.val() >= 0" },
            "produced": { ".validate": "newData.isNumber() && newData.val() >= 0" },
            "sold": { ".validate": "newData.isNumber() && newData.val() >= 0" },

            "$otro": { ".validate": true }
          }
        }
      }
    },

    // Sólo sirve para numerar las fábricas (FACTORY #007).
    "meta": {
      "counters": {
        ".read": "auth != null",
        ".write": "auth != null",
        "factories": { ".validate": "newData.isNumber() && newData.val() >= 0" },
        "$otro": { ".validate": false }
      }
    },

    // Posiciones y presencia: escrituras muy frecuentes y desechables, con
    // onDisconnect() para limpiar solo al cerrar la pestaña.
    "presence": {
      "$factoryId": {
        ".read": "auth != null",

        "$uid": {
          ".write": "auth != null && auth.uid === $uid",
          ".validate": "newData.hasChildren(['uid','name','level','x','y','dir','act','t'])",

          "uid":  { ".validate": "newData.val() === auth.uid" },
          "name": { ".validate": "newData.isString() && newData.val().length <= 20" },
          "level":{ ".validate": "newData.isNumber() && newData.val() >= 1 && newData.val() <= 10000" },

          "x": { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 1920" },
          "y": { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 1360" },

          "dir": { ".validate": "newData.isString() && newData.val().length <= 6" },
          "act": { ".validate": "newData.isString() && newData.val().length <= 10" },

          "t": { ".validate": "newData.isNumber() && newData.val() <= now + 5000" },

          "emote": { ".validate": "newData.isString() && newData.val().length <= 12" },
          "emoteAt": { ".validate": "newData.isNumber() && newData.val() <= now + 5000" },

          "appearance": {
            ".validate": "newData.hasChildren()",
            "$slot": { ".validate": "newData.isString() && newData.val().length <= 12" }
          },

          "pet": {
            "chassis": { ".validate": "newData.isString() && newData.val().length <= 12" },
            "color":   { ".validate": "newData.isString() && newData.val().length <= 12" },
            "accent":  { ".validate": "newData.isString() && newData.val().length <= 12" },
            "$other": { ".validate": false }
          },

          // Dónde está cada perro y qué hace: [x, y, act] por cabeza, en una
          // lista plana. Sin esto los demás veían la jauría pegada a su dueño
          // aunque estuviera picando al otro lado del mapa.
          "pets": {
            ".validate": "newData.hasChildren()",
            "$i": { ".validate": "newData.isNumber() && newData.val() >= -1 && newData.val() <= 2000" }
          },

          // Lo mismo para el camión: [x, y, act].
          "caex": {
            ".validate": "newData.hasChildren()",
            "$i": { ".validate": "newData.isNumber() && newData.val() >= -1 && newData.val() <= 2000" }
          },

          "caexLook": {
            "color":  { ".validate": "newData.isString() && newData.val().length <= 12" },
            "accent": { ".validate": "newData.isString() && newData.val().length <= 12" },
            "$other": { ".validate": false }
          },

          "$other": { ".validate": false }
        }
      }
    }
  }
}
