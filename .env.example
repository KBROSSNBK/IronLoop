# ─────────────────────────────────────────────────────────────
# IRONLOOP — variables de entorno
#
# Copia este archivo a `.env` y rellena los valores de TU proyecto Firebase.
# El archivo `.env` está en .gitignore: nunca subas credenciales al repo.
#
# Si NO configuras nada, el juego arranca igualmente en MODO LOCAL
# (localStorage + BroadcastChannel) y puedes probar el loop completo,
# incluido multiplayer entre pestañas del mismo navegador.
# ─────────────────────────────────────────────────────────────

# Consola Firebase → Configuración del proyecto → Tus apps → Configuración SDK
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=tu-proyecto.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=tu-proyecto
VITE_FIREBASE_STORAGE_BUCKET=tu-proyecto.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Realtime Database (para posiciones y presencia en tiempo real).
# Consola Firebase → Realtime Database → copia la URL.
# Si lo dejas vacío el juego funciona, pero no verás a los demás moverse.
VITE_FIREBASE_DATABASE_URL=https://tu-proyecto-default-rtdb.firebaseio.com

# ── Opcionales ──────────────────────────────────────────────

# Sirve el handler de OAuth desde el propio dominio de Hosting, en vez de
# <proyecto>.firebaseapp.com. Hace el login mucho más fiable en Safari/iOS
# porque deja de depender de cookies de terceros.
# ATENCIÓN: antes hay que dar de alta el redirect URI en Google Cloud Console
# (ver FIREBASE_SETUP.md § "Login fiable en móvil"), o el login fallará con
# "Error 400: redirect_uri_mismatch".
VITE_AUTH_SAME_ORIGIN=false

# Fuerza el backend local aunque haya credenciales (desarrollo sin gastar cuota).
VITE_FORCE_LOCAL=false

# Ejecuta las operaciones críticas en Cloud Functions en vez de en
# transacciones de cliente. Requiere haber desplegado `functions/`.
VITE_USE_FUNCTIONS=false

# Activa el panel de debug fuera de desarrollo (¡cuidado en producción!).
VITE_ENABLE_DEBUG=false

# UIDs con permisos de admin, separados por comas.
VITE_ADMIN_UIDS=
